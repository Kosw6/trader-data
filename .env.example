# Local PostgreSQL used by backfill commands.
DATABASE_URL="postgresql://postgres:change-me@localhost:55432/trader"

# SEC requires a descriptive User-Agent with a reachable contact address.
SEC_USER_AGENT="TraderDataBot-KR/1.0 YourName your-email@example.com"

# Korea Investment Open API credentials for overseas daily-price repair jobs.
APPKEY="your-kis-app-key"
APPSECRET="your-kis-app-secret"

# Optional cached token values. The client issues a new token when omitted or expired.
ACCESS_TOKEN=""
ACCESS_TOKEN_TOKEN_EXPIRED=""

# Marketaux local news evaluation. Keep the real value in .env.news-api,
# which is excluded by .gitignore. Never put this token in frontend code.
TRADER_NEWS_MARKETAUX_API_TOKEN=""

# Kafka consumer settings for JOB_ITEM_QUEUED events emitted by trader-controller outbox relay.
KAFKA_BROKERS="localhost:9092"
KAFKA_TOPIC="trader.jobs.events"
KAFKA_GROUP_ID="trader-data-workers"
KAFKA_CONSUMER_NAME="trader-data-worker"

# Kafka consumer settings for KIS RAW_OBJECT_READY ETL events.
KAFKA_RAW_KIS_TOPIC="trader.raw.kis.ready"
KAFKA_RAW_KIS_GROUP_ID="trader-data-kis-etl"
KAFKA_RAW_KIS_CONSUMER_NAME="kis-price-etl-worker"

# Kafka consumer settings for BLS RAW_OBJECT_READY ETL events.
KAFKA_RAW_BLS_TOPIC="trader.raw.bls.ready"
KAFKA_RAW_BLS_GROUP_ID="trader-data-bls-etl"
KAFKA_RAW_BLS_CONSUMER_NAME="bls-macro-etl-worker"

# Kafka consumer settings for SEC RAW_OBJECT_READY ETL events.
KAFKA_RAW_SEC_TOPIC="trader.raw.sec.ready"
KAFKA_RAW_SEC_GROUP_ID="trader-data-sec-etl"
KAFKA_RAW_SEC_CONSUMER_NAME="sec-financial-etl-worker"

# trader-controller callback used by collector-only workers after writing raw source_object rows.
TRADER_CONTROLLER_URL="http://localhost:8090"
ADMIN_API_KEY="change-me"

# NEWS discovery staging: requires controller V051 migration and an explicit deployment.
# Uses workers.kafka_pipeline_consumer; does not promote candidates into chatbot/RAG evidence.
NEWS_COLLECTION_ENABLED="false"
NEWS_OUTPUT_ROOT="pipeline_output/news"

# Match the controller and database fence when running coordinated recovery.
# control649 uses trader.raw.coordinated.ready649; legacy Kafka topics are unchanged.
RECOVERY_RAW_TOPIC="trader.raw.coordinated.ready"

# Explicit coordinated NEWS adapter. Mount this path on durable storage.
# This path uses LOCAL objects without changing legacy RAW_STORAGE_* S3 settings.
NEWS_RECOVERY_ENABLED="false"
NEWS_RECOVERY_RAW_ROOT="/recovery-news"
NEWS_RECOVERY_TOPIC="trader.raw.coordinated.news.ready"
NEWS_RECOVERY_GROUP="coordinated-news-local"
RECOVERY_CONTROLLER_URL="http://localhost:8090"
RECOVERY_CONTROLLER_PROXY_PREFIX=""
